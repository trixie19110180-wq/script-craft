{
  "name": "scriptcraft",
  "version": "1.0.0",
  "private": true,
  "description": "ScriptCraft is a Scratch-like creative coding platform for JavaScript, Python-style, and C-style projects.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite --host 0.0.0.0 --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "lint": "node --check server/index.js && node --check server/db.js && node --check server/auth.js && node --check server/uploads.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
